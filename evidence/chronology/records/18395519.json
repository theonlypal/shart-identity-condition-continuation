{"created": "2026-01-27T23:33:20.524473+00:00", "modified": "2026-01-27T23:33:23.522660+00:00", "id": 18395519, "conceptrecid": "18395518", "doi": "10.5281/zenodo.18395519", "conceptdoi": "10.5281/zenodo.18395518", "doi_url": "https://doi.org/10.5281/zenodo.18395519", "metadata": {"title": "Alignment Is Correct, Safe, Reproducible Behavior Under Explicit Constraints", "doi": "10.5281/zenodo.18395519", "publication_date": "2026-01-27", "description": "<p>We define alignment as correct, safe, reproducible behavior under explicit constraints. We demonstrate empirically that alignment is a system property, not a model property. The same model (GPT-5.2), given the same prompt at the same token limit and temperature, produces empty strings via the Chat Completions API and substantive responses via the Responses API. This behavioral divergence proves that alignment emerges from execution infrastructure, not model weights. We introduce a semantic field of 18 Semitic tokens meaning \"binding condition\" that consistently trigger constraint-gated behavior. We propose that aligned AI systems require verification at the execution layer, and present cryptographic attestation as one implementation.</p>", "access_right": "open", "creators": [{"name": "Pal, Rayan", "affiliation": null}], "custom": {"code:codeRepository": "https://github.com/theonlypal/Alignment-Artifact", "code:developmentStatus": {"id": "active", "title": {"en": "Active"}}}, "resource_type": {"title": "Preprint", "type": "publication", "subtype": "preprint"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "18395518"}}]}}, "title": "Alignment Is Correct, Safe, Reproducible Behavior Under Explicit Constraints", "links": {"self": "https://zenodo.org/api/records/18395519", "self_html": "https://zenodo.org/records/18395519", "preview_html": "https://zenodo.org/records/18395519?preview=1", "doi": "https://doi.org/10.5281/zenodo.18395519", "self_doi": "https://doi.org/10.5281/zenodo.18395519", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.18395519", "reserve_doi": "https://zenodo.org/api/records/18395519/draft/pids/doi", "parent": "https://zenodo.org/api/records/18395518", "parent_html": "https://zenodo.org/records/18395518", "parent_doi": "https://doi.org/10.5281/zenodo.18395518", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.18395518", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:18395519/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:18395519/sequence/default", "files": "https://zenodo.org/api/records/18395519/files", "media_files": "https://zenodo.org/api/records/18395519/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:18395519:Alignment_Is_Correct__Safe__Reproducible_Behavior_Under_Explicit_Constraints.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:18395519:Alignment_Is_Correct__Safe__Reproducible_Behavior_Under_Explicit_Constraints.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:18395519:Alignment_Is_Correct__Safe__Reproducible_Behavior_Under_Explicit_Constraints.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:18395519:Alignment_Is_Correct__Safe__Reproducible_Behavior_Under_Explicit_Constraints.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:18395519:Alignment_Is_Correct__Safe__Reproducible_Behavior_Under_Explicit_Constraints.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:18395519:Alignment_Is_Correct__Safe__Reproducible_Behavior_Under_Explicit_Constraints.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/18395519/versions/latest", "latest_html": "https://zenodo.org/records/18395519/latest", "versions": "https://zenodo.org/api/records/18395519/versions", "draft": "https://zenodo.org/api/records/18395519/draft", "access_links": "https://zenodo.org/ap