{"created": "2025-12-21T23:14:43.449993+00:00", "modified": "2025-12-21T23:14:43.772878+00:00", "id": 18012025, "conceptrecid": "18012024", "doi": "10.5281/zenodo.18012025", "conceptdoi": "10.5281/zenodo.18012024", "doi_url": "https://doi.org/10.5281/zenodo.18012025", "metadata": {"title": "SwiftAPI Attestation Protocol Specification (Version 1.0.0)", "doi": "10.5281/zenodo.18012025", "publication_date": "2025-12-21", "description": "<p>SwiftAPI is a cryptographic trust authority for governing AI execution.<br><br>This specification defines the SwiftAPI Attestation Protocol (SAP), which enforces human-issued, cryptographically verifiable authority prior to the execution of AI-initiated actions. The protocol separates intelligence from permission, enabling deterministic allow/deny enforcement, scoped authorization, revocation, and post-hoc auditability for non-deterministic agent systems.<br><br>SAP is model-agnostic and framework-agnostic, and applies uniformly to any AI system capable of initiating side effects such as API calls, infrastructure changes, financial transactions, or data access.</p>\n<p>https://swiftapi.ai</p>", "access_right": "open", "creators": [{"name": "Pal, Rayan", "affiliation": "SwiftAPI"}], "keywords": ["AI governance", "Authorization", "Cryptographic Protocols", "Agent Systems", "Execution Control", "Access Control", "Trust Authority"], "related_identifiers": [{"identifier": "https://swiftapi.ai", "relation": "isDocumentedBy", "resource_type": "publication-standard", "scheme": "url"}], "version": "1.0.0", "language": "eng", "resource_type": {"title": "Technical note", "type": "publication", "subtype": "technicalnote"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "18012024"}}]}}, "title": "SwiftAPI Attestation Protocol Specification (Version 1.0.0)", "links": {"self": "https://zenodo.org/api/records/18012025", "self_html": "https://zenodo.org/records/18012025", "preview_html": "https://zenodo.org/records/18012025?preview=1", "doi": "https://doi.org/10.5281/zenodo.18012025", "self_doi": "https://doi.org/10.5281/zenodo.18012025", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.18012025", "reserve_doi": "https://zenodo.org/api/records/18012025/draft/pids/doi", "parent": "https://zenodo.org/api/records/18012024", "parent_html": "https://zenodo.org/records/18012024", "parent_doi": "https://doi.org/10.5281/zenodo.18012024", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.18012024", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:18012025/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:18012025/sequence/default", "files": "https://zenodo.org/api/records/18012025/files", "media_files": "https://zenodo.org/api/records/18012025/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:18012025:SwiftAPI__A_Trust_Authority_for_AI_Execution.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:18012025:SwiftAPI__A_Trust_Authority_for_AI_Execution.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:18012025:SwiftAPI__A_Trust_Authority_for_AI_Execution.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:18012025:SwiftAPI__A_Trust_Authority_for_AI_Execution.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:18012025:SwiftAPI__A_Trust_Authority_for_AI_Execution.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:18012025:SwiftAPI__A_Trust_Authority_for_AI_Execution.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/18012025/versions/latest", "latest_html": "https://zenodo.org/records/18012025/latest", "versions": "https://zenodo.org/api/records/18012025/versions", "draft": "https://zenodo.org/api/records/18012025/draft", "access_links": "https://zenodo.org/api/records/18012025/access/links", "access_grants": "https://zenodo.org/api